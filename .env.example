# Identity and storage
OWNER_JID=2349159530797@s.whatsapp.net
PREFIX=!
DB_PATH=data/nexus-core.db
SESSION_DIR=data/session
LOG_LEVEL=info
TIMEZONE=UTC
LOCALE=en-GB

# Authentication: qr or pairing
AUTH_METHOD=qr
PAIRING_NUMBER=

# Reconnection backoff
RECONNECT_BASE_MS=3000
RECONNECT_MAX_MS=60000
RECONNECT_MAX_ATTEMPTS=12

# Command execution and rate limits
RATE_WINDOW_MS=10000
RATE_MAX_COMMANDS=8
EXECUTION_TIMEOUT_MS=20000
GROUP_METADATA_TTL_MS=15000

# Group security
SPAM_WINDOW_MS=6000
SPAM_THRESHOLD=7
SECURITY_ACTION_COOLDOWN_MS=30000
MAX_MENTIONS=120
PROFANITY_WORDS=

# Welcome and departure defaults (optional overrides)
DEFAULT_WELCOME_TEXT=
DEFAULT_GOODBYE_TEXT=

# AI provider (OpenAI-compatible chat completions)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=700

# Image provider (OpenAI-compatible image generations)
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
MEDIA_TIMEOUT_MS=45000
WAIFU_API_URL=https://api.waifu.pics

# Translation: LibreTranslate-compatible endpoint; without it, MyMemory is used
TRANSLATE_API_URL=
TRANSLATE_API_KEY=
TRANSLATE_TIMEOUT_MS=15000

# Public weather provider
WEATHER_TIMEOUT_MS=15000

DEBUG=false
